{
  "name": "api",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir=dist",
    "deploy": "node ../../scripts/ensure-ci-deploy.mjs && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx}\" --ignore-path ../../.prettierignore",
    "format:check": "prettier --check \"**/*.{ts,tsx}\" --ignore-path ../../.prettierignore",
    "openapi:dump": "tsx scripts/dump-openapi.mts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.5.1",
    "@prisma/client": "^7.8.0",
    "@sentry/cloudflare": "^10.65.0",
    "@workspace/auth": "workspace:^",
    "@workspace/common": "workspace:^",
    "@workspace/database": "workspace:^",
    "@workspace/domain": "workspace:^",
    "hono": "^4.12.29",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "tsx": "^4.23.0",
    "typescript": "5.9.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.10",
    "wrangler": "^4.110.0"
  }
}
