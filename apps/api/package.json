{
  "name": "api",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "pnpm bundle:openapi && wrangler dev",
    "build": "pnpm bundle:openapi && wrangler deploy --dry-run --outdir=dist",
    "deploy": "node ../../scripts/ensure-ci-deploy.mjs && pnpm bundle:openapi && wrangler deploy",
    "typecheck": "pnpm bundle:openapi && tsc --noEmit",
    "bundle:openapi": "tsx scripts/bundle-openapi.ts",
    "check:error-codes": "tsx scripts/check-error-codes.ts",
    "test": "pnpm bundle:openapi && vitest run",
    "test:watch": "pnpm bundle:openapi && vitest",
    "test:coverage": "pnpm bundle:openapi && vitest run --coverage",
    "lint": "eslint ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@hono/swagger-ui": "^0.6.1",
    "@prisma/client": "^7.8.0",
    "@sentry/cloudflare": "^10.65.0",
    "@workspace/auth": "workspace:^",
    "@workspace/database": "workspace:^",
    "@workspace/domain": "workspace:^",
    "hono": "^4.12.29",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@cloudflare/workers-types": "^4.20260702.1",
    "openapi-types": "^12.1.3",
    "tsx": "^4.23.0",
    "typescript": "5.9.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.10",
    "wrangler": "^4.110.0"
  }
