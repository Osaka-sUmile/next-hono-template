# wrangler dev 用のローカル環境変数。`.dev.vars` にコピーして実値を埋めること（.dev.vars は gitignore 対象）。
NODE_ENV=development

# Database connection string (Neon serverless driver + docker wsproxy 経由でローカル Postgres に接続)
DATABASE_URL="postgresql://user:password@localhost:5432/app"

# Auth (better-auth)
# AUTH_SECRET は `openssl rand -base64 32` で生成した値に置き換えること（本番とは別の値を使う）。
AUTH_SECRET="your-secret-key-at-least-32-characters-long"
API_BASE_URL="http://localhost:8080"
WEB_BASE_URL="http://localhost:3001"

# Resend (Email OTP)
# メール OTP を試すときだけ実値が必要（https://resend.com → API Keys, 権限は Sending access）。
# 試さない間はこのダミー値のままで起動できる（送信時にエラーになるだけ）。
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
# Resend のサンドボックス送信元。ドメイン検証なしで送信できる（送信先は Resend アカウント登録メール宛のみ）。
# 独自ドメインを検証済みなら noreply@<検証済みドメイン> に変更する。
RESEND_FROM_EMAIL=onboarding@resend.dev

# Google OAuth
# Google ログインを試すときだけ実値が必要（Google Cloud Console → Credentials → OAuth クライアント ID）。
# リダイレクト URI には {API_BASE_URL}/api/auth/callback/google を登録する。
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Apple OAuth
# Apple ログインを試すときだけ実値が必要（Apple Developer で Services ID と秘密鍵を作成）。
APPLE_CLIENT_ID="your-apple-client-id"
APPLE_CLIENT_SECRET="your-apple-private-key-pem"

# Sentry (BE error monitoring). 未設定ならエラー監視・トレーシングは無効。
SENTRY_DSN=""
# トレースのサンプリング率 (0〜1) の上書き。通常は設定不要。
# 既定値は環境名から決まる (production 0.1 / preview 0.2 / それ以外 1.0)。
# 詳細は docs/deployment.md「Sentry のトレーシングとサンプリング方針」を参照。
# SENTRY_TRACES_SAMPLE_RATE=""

# Cloudflare Turnstile (captcha, issue #41)。必須。
# 以下は Cloudflare の公式テストシークレットキー(常に検証成功を返す)。
# 実運用のキーは docs/deployment.md の Turnstile セットアップ手順を参照して発行すること。
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"
