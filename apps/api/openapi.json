{
  "openapi": "3.0.3",
  "info": {
    "title": "API",
    "description": "Backend API specification",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/",
      "description": "Same origin as this document"
    }
  ],
  "components": {
    "securitySchemes": {
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "better-auth.session_token"
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The user ID"
          },
          "email": {
            "type": "string",
            "format": "email",
            "description": "User email address"
          },
          "name": {
            "type": "string",
            "description": "User full name"
          },
          "role": {
            "type": "string",
            "enum": [
              "user",
              "admin"
            ],
            "description": "User role"
          },
          "displayName": {
            "type": "string",
            "nullable": true,
            "description": "User display name (user-settable)"
          },
          "image": {
            "type": "string",
            "nullable": true,
            "description": "User avatar URL"
          },
          "emailVerified": {
            "type": "boolean",
            "description": "Whether the email address has been verified"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "email",
          "name",
          "role",
          "displayName",
          "image",
          "emailVerified",
          "createdAt"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "Error message describing the issue"
          },
          "code": {
            "type": "string",
            "enum": [
              "USER_NOT_FOUND",
              "SESSION_INVALID",
              "SESSION_EXPIRED",
              "SESSION_FETCH_FAILED",
              "FORBIDDEN",
              "FEEDBACK_SURVEY_NOT_FOUND",
              "FEEDBACK_INVALID_ANSWER",
              "RATE_LIMIT_EXCEEDED",
              "VALIDATION_ERROR",
              "INTERNAL_ERROR"
            ],
            "description": "Machine-readable error code for client-side handling."
          }
        },
        "required": [
          "error",
          "code"
        ]
      },
      "UserProfile": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "user",
              "admin"
            ]
          },
          "displayName": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "email",
          "name",
          "role",
          "displayName"
        ]
      },
      "UserList": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/User"
            }
          },
          "total": {
            "type": "integer",
            "description": "Total users matching the filters"
          },
          "limit": {
            "type": "integer"
          },
          "offset": {
            "type": "integer"
          }
        },
        "required": [
          "items",
          "total",
          "limit",
          "offset"
        ]
      },
      "FeedbackSurvey": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "questions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FeedbackQuestion"
            }
          }
        },
        "required": [
          "id",
          "slug",
          "title",
          "questions"
        ]
      },
      "FeedbackQuestion": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "single_choice",
              "text"
            ],
            "description": "Answer input type"
          },
          "text": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "sortOrder": {
            "type": "integer"
          },
          "choices": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FeedbackChoice"
            },
            "description": "Empty for text questions"
          }
        },
        "required": [
          "id",
          "type",
          "text",
          "required",
          "sortOrder",
          "choices"
        ]
      },
      "FeedbackChoice": {
        "type": "object",
        "properties": {
          "value": {
            "type": "string",
            "description": "Stable value used as the tally key"
          },
          "label": {
            "type": "string",
            "description": "Label shown to respondents"
          },
          "sortOrder": {
            "type": "integer",
            "description": "Display order within the question"
          }
        },
        "required": [
          "value",
          "label",
          "sortOrder"
        ]
      },
      "FeedbackSubmissionAccepted": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "surveyId": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "surveyId",
          "createdAt"
        ]
      },
      "FeedbackSurveyList": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FeedbackSurveyListItem"
            }
          }
        },
        "required": [
          "items"
        ]
      },
      "FeedbackSurveyListItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "isActive": {
            "type": "boolean",
            "description": "Whether respondents can currently answer it"
          },
          "questionCount": {
            "type": "integer"
          },
          "submissionCount": {
            "type": "integer",
            "description": "Total submissions, including repeat submissions"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "slug",
          "title",
          "isActive",
          "questionCount",
          "submissionCount",
          "createdAt"
        ]
      },
      "FeedbackSurveyDetail": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "isActive": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "questions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FeedbackQuestion"
            }
          }
        },
        "required": [
          "id",
          "slug",
          "title",
          "isActive",
          "createdAt",
          "questions"
        ]
      },
      "FeedbackSubmissionList": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FeedbackSubmission"
            }
          },
          "total": {
            "type": "integer",
            "description": "Total submissions matching the filter"
          },
          "limit": {
            "type": "integer"
          },
          "offset": {
            "type": "integer"
          }
        },
        "required": [
          "items",
          "total",
          "limit",
          "offset"
        ]
      },
      "FeedbackSubmission": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "surveyId": {
            "type": "string"
          },
          "user": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "email": {
                "type": "string",
                "format": "email"
              },
              "name": {
                "type": "string"
              },
              "displayName": {
                "type": "string",
                "nullable": true
              }
            },
            "required": [
              "id",
              "email",
              "name",
              "displayName"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "answers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FeedbackSubmissionAnswer"
            }
          }
        },
        "required": [
          "id",
          "surveyId",
          "user",
          "createdAt",
          "answers"
        ]
      },
      "FeedbackSubmissionAnswer": {
        "type": "object",
        "properties": {
          "questionId": {
            "type": "string"
          },
          "questionText": {
            "type": "string"
          },
          "choiceValue": {
            "type": "string",
            "nullable": true
          },
          "choiceLabel": {
            "type": "string",
            "nullable": true
          },
          "textValue": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "questionId",
          "questionText",
          "choiceValue",
          "choiceLabel",
          "textValue"
        ]
      },
      "FeedbackSummary": {
        "type": "object",
        "properties": {
          "surveyId": {
            "type": "string"
          },
          "respondentCount": {
            "type": "integer",
            "description": "Distinct respondents, counting only each user's latest submission"
          },
          "tallies": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "questionId": {
                  "type": "string"
                },
                "choiceValue": {
                  "type": "string"
                },
                "count": {
                  "type": "integer"
                }
              },
              "required": [
                "questionId",
                "choiceValue",
                "count"
              ]
            },
            "description": "Single-choice tallies only; text answers are not aggregated"
          }
        },
        "required": [
          "surveyId",
          "respondentCount",
          "tallies"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Checking API health",
        "description": "Returns a simple message to verify that the API is running",
        "responses": {
          "200": {
            "description": "API is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ok"
                    }
                  },
                  "required": [
                    "status"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/me": {
      "get": {
        "tags": [
          "Users"
        ],
        "summary": "Get current user",
        "description": "Returns the authenticated user's profile",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Current user profile",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "Users"
        ],
        "summary": "Update current user's profile",
        "description": "Updates the authenticated user's display name",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "displayName": {
                    "type": "string",
                    "nullable": true,
                    "maxLength": 100,
                    "description": "New display name. Send null (or an empty string) to clear it."
                  }
                },
                "required": [
                  "displayName"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated profile",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserProfile"
                }
              }
            }
          },
          "400": {
            "description": "Request validation failed (VALIDATION_ERROR). Malformed JSON body or schema mismatch.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected internal server error (INTERNAL_ERROR).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/admin/users": {
      "get": {
        "tags": [
          "Admin"
        ],
        "summary": "Search users (admin only)",
        "description": "Search and page through users. Requires an authenticated session whose role is admin.",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20,
              "description": "Page size (1-100)"
            },
            "required": false,
            "description": "Page size (1-100)",
            "name": "limit",
            "in": "query"
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            },
            "required": false,
            "description": "Number of users to skip",
            "name": "offset",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "maxLength": 100,
              "description": "Case-insensitive match against email, name, or display name"
            },
            "required": false,
            "description": "Case-insensitive match against email, name, or display name",
            "name": "search",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "user",
                "admin"
              ],
              "description": "Restrict results to one user role"
            },
            "required": false,
            "description": "Restrict results to one user role",
            "name": "role",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "A page of users",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserList"
                }
              }
            }
          },
          "400": {
            "description": "Invalid paging or filter parameters (VALIDATION_ERROR)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized (missing or invalid session)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden (authenticated but not an admin)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/feedback/survey": {
      "get": {
        "tags": [
          "Feedback"
        ],
        "summary": "Get the active feedback survey",
        "description": "Returns the questions and choices of the currently active survey. Requires an authenticated session.",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "The active survey",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FeedbackSurvey"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized (missing or invalid session)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "No survey is currently active (FEEDBACK_SURVEY_NOT_FOUND)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/feedback/submissions": {
      "post": {
        "tags": [
          "Feedback"
        ],
        "summary": "Submit answers to the active feedback survey",
        "description": "Records the authenticated user's answers. Repeat submissions are allowed; aggregation uses only each user's latest submission.",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "answers": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "questionId": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 64
                        },
                        "choiceValue": {
                          "type": "string",
                          "maxLength": 100,
                          "description": "Required for single_choice questions"
                        },
                        "textValue": {
                          "type": "string",
                          "maxLength": 2000,
                          "description": "Required for text questions"
                        }
                      },
                      "required": [
                        "questionId"
                      ],
                      "additionalProperties": false
                    },
                    "maxItems": 50,
                    "description": "One entry per answered question"
                  }
                },
                "required": [
                  "answers"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The submission was recorded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FeedbackSubmissionAccepted"
                }
              }
            }
          },
          "400": {
            "description": "Request validation failed (VALIDATION_ERROR) or the answers violate the survey contract (FEEDBACK_INVALID_ANSWER)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized (missing or invalid session)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "No survey is currently active (FEEDBACK_SURVEY_NOT_FOUND)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Too many submissions (RATE_LIMIT_EXCEEDED)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/admin/feedback/surveys": {
      "get": {
        "tags": [
          "Admin"
        ],
        "summary": "List feedback surveys (admin only)",
        "description": "Returns every survey newest first, including inactive ones, with question and submission counts. Requires an admin session.",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Every survey",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FeedbackSurveyList"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized (missing or invalid session)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden (authenticated but not an admin)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/admin/feedback/surveys/{surveyId}": {
      "get": {
        "tags": [
          "Admin"
        ],
        "summary": "Get one feedback survey with its questions (admin only)",
        "description": "Returns the survey with its questions and choices. The summary endpoint returns tallies keyed by questionId and choiceValue only, so this is what supplies the labels. Requires an admin session.",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "description": "Survey to retrieve"
            },
            "required": true,
            "description": "Survey to retrieve",
            "name": "surveyId",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "The survey and its questions",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FeedbackSurveyDetail"
                }
              }
            }
          },
          "400": {
            "description": "Invalid surveyId (VALIDATION_ERROR)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized (missing or invalid session)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden (authenticated but not an admin)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "No survey has that id (FEEDBACK_SURVEY_NOT_FOUND)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
