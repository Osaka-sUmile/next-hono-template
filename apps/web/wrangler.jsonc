{
  "$schema": "node_modules/wrangler/config-schema.json",
  // top-level はローカル開発 (`wrangler dev` / `pnpm preview`) 用。デプロイは env.preview / env.production を使う。
  "name": "web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // assets は env に継承される (inheritable) ため top-level の定義のみでよい。
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Next.js の ISR/リバリデーション等が自身に fetch するためのセルフバインディング。
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "web"
    }
  ],
  // NEXT_PUBLIC_* の環境変数はこのファイルには定義しない。
  // - クライアントバンドル向け: ビルド時に .env.local / CI の環境変数として next build へ
  //   渡す必要がある (ここに置いてもクライアントには反映されない)。
  // - サーバー側 (SSR) ランタイム向け: デプロイ環境は CI (deploy.yml) が GitHub Environment
  //   Variables の値を `wrangler deploy --var` で注入し、ローカル実行は .dev.vars を使う。
  // services は env に継承されない (non-inheritable) ため、各 env で再定義する。
  // WORKER_SELF_REFERENCE は自 env の worker 名に向けること (web-preview は web-preview を参照)。
  // NEXT_PUBLIC_* (サーバー側 process.env 用) は各 env には定義しない。実値は GitHub
  // Environment Variables を唯一のソースとし、CI (deploy.yml) が `--var` で注入する。
  "env": {
    "preview": {
      "name": "web-preview",
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "web-preview"
        }
      ]
    },
    "production": {
      "name": "web-production",
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "web-production"
        }
      ]
    }
  }
}
