{
  "name": "web",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "node ../../scripts/ensure-ci-deploy.mjs && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts",
    "lint": "eslint",
    "lint:type-aware": "eslint -c eslint.type-aware.config.js .",
    "format": "prettier --write \"**/*.{ts,tsx}\" --ignore-path ../../.prettierignore",
    "format:check": "prettier --check \"**/*.{ts,tsx}\" --ignore-path ../../.prettierignore",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "api-types:generate": "openapi-typescript ../../apps/api/openapi.json -o lib/api-schema.d.ts"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.2.2",
    "@hugeicons/react": "^1.1.9",
    "@marsidev/react-turnstile": "^1.5.3",
    "@opennextjs/cloudflare": "^1.20.1",
    "@sentry/nextjs": "^10.65.0",
    "@workspace/auth": "workspace:*",
    "@workspace/common": "workspace:*",
    "@workspace/ui": "workspace:*",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "openapi-fetch": "^0.17.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/ui": "^4.1.10",
    "@workspace/eslint-config": "workspace:^",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "^9.39.5",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "5.9.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.10",
    "wrangler": "^4.110.0"
  }
}
