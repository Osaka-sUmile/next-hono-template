# Cloudflare Workers ローカル実行 (wrangler dev / opennextjs-cloudflare preview) 用の環境変数。
# 実際に使う場合は `.dev.vars` にコピーして値を設定する（.dev.vars は git 管理対象外）。
#
# 注意: ここに書いた値は wrangler/preview 実行時にサーバー側 (SSR) の process.env に
# 注入されるのみで、クライアントバンドルへは反映されない。
# クライアントバンドルに埋め込む値は、ビルド時に apps/web/.env.local や CI の環境変数として
# `pnpm build` (= opennextjs-cloudflare build) 実行前に next build へ渡す必要がある。
# 以下で NEXT_PUBLIC_* をあえてここにも置いているのは、SSR 側で参照する値と
# クライアントに埋め込まれる値の整合を保つため（値をずれさせないための重複定義）。

# OpenNext (@opennextjs/cloudflare) が preview 実行時にどの .env.* を読み込むかを制御する。
# development を指定すると .env.development 等が対象になる。
NEXTJS_ENV=development

# --- サーバー側 (SSR / Node.js ランタイム) から参照する変数の例 ---
NEXT_PUBLIC_API_URL="http://localhost:8080"
NEXT_PUBLIC_SENTRY_DSN=""
