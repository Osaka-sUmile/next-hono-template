# apps/web のローカル開発用環境変数のテンプレート。
# 使う場合は以下のようにコピーしてから値を設定する（.env.local は git 管理対象外）。
#   cp .env.local.example .env.local
#
# NEXT_PUBLIC_* はビルド時にクライアントバンドルへインライン埋め込みされる。
# 本番デプロイ時はビルド実行環境 / CI のシークレット経由で値を供給すること。

# API (wrangler dev) の URL。未設定だと next build が失敗する。
NEXT_PUBLIC_API_URL="http://localhost:8787"

# Sentry の DSN。未設定ならフロントエンドのエラー監視・トレーシングは無効になる。
NEXT_PUBLIC_SENTRY_DSN=""
# トレースのサンプリング率 (0〜1) の上書き。通常は設定不要。
# 既定値は環境名から決まる (production 0.1 / preview 0.2 / それ以外 1.0)。
# NEXT_PUBLIC_* はビルド時にインライン化されるため、変更したら再ビルドが必要。
# 詳細は docs/deployment.md「Sentry のトレーシングとサンプリング方針」を参照。
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=""

# Cloudflare Turnstile のサイトキー。未設定だと next build が失敗する。
# 以下はテスト用サイトキー(常にチャレンジが自動成功する)。実運用のキーは
# docs/deployment.md の Turnstile セットアップ手順を参照して発行すること。
NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
