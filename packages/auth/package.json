{
  "name": "@workspace/auth",
  "version": "0.0.1",
  "private": true,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./src/server.ts",
      "default": "./dist/server.js"
    },
    "./client": {
      "types": "./src/client.ts",
      "default": "./dist/client.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:type-aware": "eslint -c eslint.type-aware.config.mjs .",
    "test": "vitest run"
  },
  "dependencies": {
    "better-auth": "^1.6.23",
    "resend": "^4.8.0"
  },
  "peerDependencies": {
    "@prisma/client": "^7",
    "react": "^19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@workspace/database": "workspace:*",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "typescript": "7.0.2",
    "vite": "^8.0.16",
    "vitest": "^4.1.10"
  }
}
