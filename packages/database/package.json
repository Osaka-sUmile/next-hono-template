{
  "name": "@workspace/database",
  "version": "0.0.1",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "lint:type-aware": "eslint -c eslint.type-aware.config.mjs .",
    "format": "prettier --write \"**/*.{ts,tsx}\" --ignore-path ../../.prettierignore",
    "format:check": "prettier --check \"**/*.{ts,tsx}\" --ignore-path ../../.prettierignore",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:test:migrate:deploy": "prisma migrate deploy --config prisma.test.config.ts",
    "db:migrate:status": "prisma migrate status",
    "db:studio": "prisma studio",
    "promote-admin": "tsx scripts/promote-admin.mts",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "vitest run",
    "test:integration:watch": "vitest"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/adapter-neon": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@workspace/domain": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.9.5",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "dotenv": "^17.4.2",
    "eslint": "^10.0.0",
    "prisma": "^7.8.0",
    "tsx": "^4.23.0",
    "typescript": "5.9.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.10"
  }
}
