// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ID の方針: 主キーは UUIDv4 (`@default(uuid(4))`) で統一する。カラム型は `text` のままとし
// `@db.Uuid` は使わない (seed が `feedback-survey-pmf-2026` のような可読 ID を入れるため)。
// 保存前に ID を確定させる必要がある場合のみ domain の IIdGenerator を注入して採番する。
// なお `uuid()` は SQL の DEFAULT 句にならないため、生 SQL の INSERT では id を必ず明示する。

enum UserRole {
  user
  admin
}

enum FeedbackQuestionType {
  single_choice
  text
}

model User {
  id                  String               @id @default(uuid(4))
  name                String
  email               String               @unique
  emailVerified       Boolean              @default(false)
  image               String?
  role                UserRole             @default(user)
  displayName         String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  sessions            Session[]
  accounts            Account[]
  feedbackSubmissions FeedbackSubmission[]
}

model Session {
  id        String   @id @default(uuid(4))
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(uuid(4))
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([accountId, providerId])
  @@unique([userId, providerId])
}

model Verification {
  id         String    @id @default(uuid(4))
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt
}

/// 設問セット。設問を差し替えても過去の回答を壊さないためバージョンとして分離する。
model FeedbackSurvey {
  id          String               @id @default(uuid(4))
  slug        String               @unique
  title       String
  isActive    Boolean              @default(false)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  questions   FeedbackQuestion[]
  submissions FeedbackSubmission[]

  @@index([isActive])
}

model FeedbackQuestion {
  id        String               @id @default(uuid(4))
  surveyId  String
  survey    FeedbackSurvey       @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  type      FeedbackQuestionType
  text      String
  required  Boolean              @default(false)
  sortOrder Int
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  choices   FeedbackChoice[]
  answers   FeedbackAnswer[]

  @@unique([surveyId, sortOrder])
  @@index([surveyId])
}

/// 単一選択の選択肢。value は集計キー、label は表示文言。
model FeedbackChoice {
  id         String           @id @default(uuid(4))
  questionId String
  question   FeedbackQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  value      String
  label      String
  sortOrder  Int
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  answers    FeedbackAnswer[]

  @@unique([questionId, value])
  @@unique([questionId, sortOrder])
  @@index([questionId])
}

/// 1 回の提出。重複提出を許可するため userId に unique は張らない。
model FeedbackSubmission {
  id        String           @id @default(uuid(4))
  surveyId  String
  survey    FeedbackSurvey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())
  answers   FeedbackAnswer[]

  @@index([surveyId, createdAt(sort: Desc), id(sort: Desc)])
  // 「ユーザーごとに最新 1 件」を DISTINCT ON で引くための複合インデックス
  @@index([surveyId, userId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
}

model FeedbackAnswer {
  id           String             @id @default(uuid(4))
  submissionId String
  submission   FeedbackSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  questionId   String
  question     FeedbackQuestion   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  choiceId     String?
  choice       FeedbackChoice?    @relation(fields: [choiceId], references: [id], onDelete: Restrict)
  textValue    String?
  createdAt    DateTime           @default(now())

  @@unique([submissionId, questionId])
  @@index([questionId, choiceId])
}
