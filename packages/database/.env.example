# prisma CLI (migrate/generate/studio) が dotenv/config 経由で読み込む接続文字列。
# ローカル docker の Postgres (docker-compose.yml の db サービス) を指す。
# prisma CLI はホストマシンから直接実行するため、コンテナ名 "db" ではなく localhost:5432 を使う。
DATABASE_URL="postgresql://user:password@localhost:5432/app"

# DB 結合テスト専用の接続文字列。誤 truncate 防止のため、データベース名は必ず _test で終える。
# DATABASE_URL へのフォールバックは行わない。
TEST_DATABASE_URL="postgresql://user:password@localhost:5432/app_test"
