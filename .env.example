# Application environment (development | test | production)
# Set to "production" on your hosting service to hide error details in responses.
NODE_ENV="development"

# Port the API server listens on (default: 8080)
PORT=8080

# Database connection string for Prisma and pg adapter
DATABASE_URL="postgresql://user:password@db:5432/app"
POSTGRES_USER="user"
POSTGRES_PASSWORD="password"
POSTGRES_DB="app"

# Optional: override the OpenAPI YAML path served at /api-docs.
# Defaults to apps/api/docs/openapi.yaml relative to the runtime location.
# OPENAPI_PATH=/app/docs/openapi.yaml

# Auth (better-auth)
AUTH_SECRET="your-secret-key-at-least-32-characters-long"
API_BASE_URL="http://localhost:8080"
WEB_BASE_URL="http://localhost:3001"
NEXT_PUBLIC_API_URL="http://localhost:8080"

# Resend (Email OTP)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
RESEND_FROM_EMAIL=noreply@example.com

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Apple OAuth
APPLE_CLIENT_ID="your-apple-client-id"
APPLE_CLIENT_SECRET="your-apple-private-key-pem"

# Sentry (BE error monitoring). 未設定ならエラー監視は無効。
SENTRY_DSN=""

# Sentry (FE error monitoring). 未設定ならエラー監視は無効。
# ⚠️ Next.js はルートの .env ではなく apps/web/.env.local から読み込む。
#    実際の値は apps/web/.env.local に設定すること。
NEXT_PUBLIC_SENTRY_DSN=""
