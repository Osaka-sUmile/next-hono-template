# Database connection string for Prisma and pg adapter
DATABASE_URL="postgresql://user:password@db:5432/yomutan"
POSTGRES_USER="user"
POSTGRES_PASSWORD="password"

# Optional: override the OpenAPI YAML path served at /api-docs.
# Defaults to apps/api/docs/openapi.yaml relative to the runtime location.
# OPENAPI_PATH=/app/docs/openapi.yaml

# Auth (better-auth)
AUTH_SECRET="your-secret-key-at-least-32-characters-long"
API_BASE_URL="http://localhost:8080"
WEB_BASE_URL="http://localhost:3001"
NEXT_PUBLIC_API_URL="http://localhost:8080"

# Resend (Email OTP)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Apple OAuth
APPLE_CLIENT_ID="your-apple-client-id"
APPLE_CLIENT_SECRET="your-apple-private-key-pem"
