# このファイル（ルートの .env）は docker compose 専用です。
# docker compose はプロジェクトルートの .env を自動で読み込み、
# 下記の POSTGRES_* を db サービスのコンテナ初期化に渡します。
#
# 環境変数の全体像（このファイルが担うのはごく一部です）:
#   - ルート .env              → docker compose (Postgres 資格情報) 専用。このファイル。
#   - API ローカル実行          → apps/api/.dev.vars
#                                 (apps/api/.dev.vars.example を参照してコピー・編集)
#   - API 本番                 → `wrangler secret put` + apps/api/wrangler.jsonc の vars
#   - DB マイグレーション/Studio → packages/database/.env
#                                 (packages/database/.env.example を参照してコピー・編集)
#                                 (prisma CLI が dotenv/config 経由で読み込む)
#   - web                      → apps/web/.env.local

# docker compose の db サービス (Postgres) の初期化用資格情報
POSTGRES_USER="user"
POSTGRES_PASSWORD="password"
POSTGRES_DB="app"
