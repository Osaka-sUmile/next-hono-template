# Database connection string for Prisma and pg adapter
DATABASE_URL="postgresql://user:password@db:5432/yomutan"
POSTGRES_USER="user"
POSTGRES_PASSWORD="password"

# Optional: override the OpenAPI YAML path served at /api-docs.
# Defaults to apps/api/docs/openapi.yaml relative to the runtime location.
# OPENAPI_PATH=/app/docs/openapi.yaml

# JWT — secrets must be 32+ characters
JWT_SECRET="change-me-to-a-random-32-or-more-char-secret"
JWT_REFRESH_SECRET="change-me-to-another-random-32-or-more-char-secret"
# Duration format: number + unit (s=seconds, m=minutes, h=hours, d=days)
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Email (required in production, optional in development)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="user@example.com"
SMTP_PASS="password"
MAIL_FROM="noreply@example.com"

# Base URL of the frontend app (used in password-reset email links)
APP_BASE_URL="http://localhost:3000"
